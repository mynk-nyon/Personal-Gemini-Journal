rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile / Settings
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Journal Entries (Scoped by user)
    match /users/{userId}/journalEntries/{entryId} {
      // User can only read their own entries
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // User can create if the uid matches and the document contains the correct uid
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId;
                    
      // User can update if the uid matches, and they cannot change the owner uid
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId;
                    
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
